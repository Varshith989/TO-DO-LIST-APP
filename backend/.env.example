# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Leave empty or set to mongodb://localhost:27017/taskmaster.
# If unavailable or offline, the server automatically spins up an in-memory MongoDB fallback)
MONGODB_URI=mongodb://localhost:27017/taskmaster

# JWT Authentication Config
JWT_SECRET=super_secret_jwt_key_taskmaster_prod_2026_xyz
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=*
