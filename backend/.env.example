# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username> and <password> with your credentials.
# Note: If left blank or unreachable, the server automatically spins up an in-memory MongoDB fallback.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pxolmek.mongodb.net/taskmaster?retryWrites=true&w=majority

# JWT Authentication Config
JWT_SECRET=super_secret_jwt_key_taskmaster_prod_2026_xyz
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=*
